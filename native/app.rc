// Resource script for Lucy
#include "resource.h"
#include <windows.h>

// Icon — if icon file is missing at build time the default system icon is used.
#ifdef HAVE_ICON
IDI_APP_ICON ICON "lucy.ico"
#endif

// Version info block
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Al-Esraa University — Section A3"
            VALUE "FileDescription",  "Lucy — Intelligent Neural Assistant"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Lucy"
            VALUE "OriginalFilename", "Lucy.exe"
            VALUE "ProductName",      "Lucy"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "(c) 2026 Zahraa Haider, Ali Shihab, Rafid Jawad"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Embed a Windows 10/11 application manifest for DPI + common controls.
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif
1 RT_MANIFEST "app.manifest"
